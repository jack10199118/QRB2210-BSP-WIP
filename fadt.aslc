/*
 * FADT for QRB2210 (hardware-reduced ACPI, PSCI over SMC).
 * Written for EDK2: build it as part of your platform AcpiTables.inf, where
 * IndustryStandard/Acpi63.h defines EFI_ACPI_6_3_FIXED_ACPI_DESCRIPTION_TABLE.
 * NOT compiled. Field names are from memory of EDK2's Acpi63.h; check them there.
 * The DSDT address and checksum are filled in by the EDK2 ACPI table driver.
 */
#include <IndustryStandard/Acpi.h>

#define OEM_ID_BYTES   'Q','C','O','M',' ',' '
#define OEM_TBL_BYTES  'Q','R','B','2','2','1','0',' '

EFI_ACPI_6_3_FIXED_ACPI_DESCRIPTION_TABLE Fadt = {
  {
    EFI_ACPI_6_3_FIXED_ACPI_DESCRIPTION_TABLE_SIGNATURE,        /* 'FACP' */
    sizeof (EFI_ACPI_6_3_FIXED_ACPI_DESCRIPTION_TABLE),
    EFI_ACPI_6_3_FIXED_ACPI_DESCRIPTION_TABLE_REVISION,
    0,                                                           /* checksum: patched by firmware */
    { OEM_ID_BYTES },
    SIGNATURE_64 (OEM_TBL_BYTES),
    1,                                                           /* OEM revision */
    0x4C544E49,                                                  /* creator 'INTL' */
    0x20200925
  },
  .FirmwareCtrl      = 0,
  .Dsdt              = 0,                                        /* TODO: use XDsdt */
  .Reserved0         = 0,
  .PreferredPmProfile = EFI_ACPI_6_3_PM_PROFILE_UNSPECIFIED,     /* or SLATE/TABLET per product */
  .Flags             = EFI_ACPI_6_3_HW_REDUCED_ACPI | EFI_ACPI_6_3_LOW_POWER_S0_IDLE_CAPABLE,
  .ArmBootArch       = EFI_ACPI_6_3_ARM_PSCI_COMPLIANT,          /* conduit SMC: HVC flag clear (DTS: method = "smc") */
  .MinorVersion      = 3,
  .XFirmwareCtrl     = 0,
  .XDsdt             = 0                                         /* TODO: set from the platform DSDT build */
  /* every other field (PM1/GPE blocks, SCI, SMI, reset reg, sleep regs): 0 for hardware-reduced ACPI */
};

VOID *ReferenceAcpiTable = &Fadt;
